{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "cmake-configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-B", "build",
                "-G", "Ninja",
                "-DCMAKE_BUILD_TYPE=Debug",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON",
                "-DCMAKE_CXX_COMPILER=/usr/bin/g++-14"
            ],
            "problemMatcher": []
        },
        {
            "label": "ninja-build",
            "type": "shell",
            "command": "ninja",
            "args": ["-C", "build"],
            "dependsOn": ["cmake-configure"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}